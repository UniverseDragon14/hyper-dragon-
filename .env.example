# Server-side only. Never commit a real key.
AI_PROVIDER=kimi
MOONSHOT_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_REASONING_EFFORT=max

# Output and abuse controls
NOVA_MAX_COMPLETION_TOKENS=1200
NOVA_REQUEST_TIMEOUT_MS=120000
NOVA_RATE_LIMIT_WINDOW_MS=60000
NOVA_RATE_LIMIT_MAX=20

# Optional local Pi MQTT bridge. Keep disabled in cloud deployments.
MQTT_ENABLED=false
MQTT_BROKER=mqtt://192.168.70.196
MQTT_TOPIC=UniversalDragon/NOVA/Reply
