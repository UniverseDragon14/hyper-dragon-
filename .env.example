# Universal Dragon EVE NOVA private adapter.
# Server-side only. Never commit real values.
UD_BRAIN_TOKEN=
UD_BRAIN_ENDPOINT=
UD_BRAIN_MODEL_ID=

# Generic OpenAI-compatible request controls.
# Use max_tokens or max_completion_tokens depending on the private adapter.
UD_BRAIN_OUTPUT_FIELD=max_tokens
UD_BRAIN_MAX_OUTPUT_TOKENS=1200
UD_BRAIN_REQUEST_TIMEOUT_MS=120000

# Optional adapter-specific JSON. Keep secrets out of this field.
# Example: {"reasoning_effort":"max"}
UD_BRAIN_EXTRA_JSON={}

# Output and abuse controls.
UD_RATE_LIMIT_WINDOW_MS=60000
UD_RATE_LIMIT_MAX=20

# Optional local Pi signal bridge. Keep disabled in cloud deployments.
MQTT_ENABLED=false
MQTT_BROKER=mqtt://192.168.70.196
MQTT_TOPIC=UniversalDragon/NOVA/Reply
